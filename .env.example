# Copy to .env and fill in. .env is git-ignored.
OPENAI_API_KEY=your-openai-api-key-here

# Optional overrides (defaults shown)
# IMAGE_MODEL=gpt-image-2
# TEXT_MODEL=gpt-5.5
# IMAGE_SIZE=2560x2560
# IMAGE_QUALITY=medium
# USE_LLM_VARIATION=true
# GRID_ROWS=4
# GRID_COLS=4
# TILE_SIZE=640
# INNER_CROP=0.06
# RETRIES=3
# SLEEP_SECONDS=2
# OVERWRITE=false
# OUTPUT_DIR=output
